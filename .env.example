# Environment variables template for ProjectHub AI
DJANGO_SECRET_KEY=django-insecure-projecthub-ai-secret-key-development-mode-10-10
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,*.onrender.com

# Database Configuration (PostgreSQL for production, SQLite fallback for local dev)
# Example: postgres://user:password@localhost:5432/projecthub_db
DATABASE_URL=sqlite:///db.sqlite3

# Redis Configuration (For Celery & Channels WebSocket)
REDIS_URL=redis://127.0.0.1:6379/0

# LLM API Keys (Optional - Intelligent context fallback used if omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
