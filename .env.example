# Environment variables template for ProjectHub AI
DJANGO_SECRET_KEY=django-insecure-projecthub-ai-secret-key-development-mode-10-10
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Optional for Production PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/projecthub_db

# LLM API Keys (Optional - Fallback generator used if omitted)
OPENAI_API_KEY=
GEMINI_API_KEY=
