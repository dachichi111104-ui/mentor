# ProjectHub AI Environment Template (.env.example)

# Django Core
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database & Redis
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/projecthub_db
REDIS_URL=redis://127.0.0.1:6379/0

# AI Provider Configuration (gemini | openai | anthropic | none)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
AI_TIMEOUT_SECONDS=10
AI_MAX_RETRIES=2
AI_CACHE_TTL=600
AI_RATE_LIMIT_PER_HOUR=20

# AI Microservice Inter-Service Auth
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=CHANGE_ME

# Admin & Seed Defaults
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@vaa.edu.vn
ADMIN_PASSWORD=CHANGE_ME
DEMO_PASSWORD=CHANGE_ME
SEED_DEMO=0

# Storage & Mail
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
